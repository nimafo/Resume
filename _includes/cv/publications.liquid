{% comment %}
  Publications redirected to external profiles
{% endcomment %}

<div class="card-text font-weight-light">

  <p>Full list of publications:</p>

  <ul class="list-unstyled pub-links">
    <li>
      <a href="{{ site.scholar_url }}" target="_blank" rel="noopener">
