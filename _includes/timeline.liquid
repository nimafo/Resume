<!-- Updates timeline: data in _data/timeline.yml -->
<style>
  body:has(.tl-wrap) .container { max-width: 1240px; }
  .tl-wrap { font-family: "Calibri Light", Calibri, Carlito, "Segoe UI", sans-serif; font-weight: 300; }
  .tl-scroll { height: 75vh; min-height: 420px; overflow-y: auto; overflow-x: hidden; position: relative; scrollbar-width: none;
               -webkit-mask-image: linear-gradient(transparent, #000 10%, #000 90%, transparent);
                       mask-image: linear-gradient(transparent, #000 10%, #000 90%, transparent); }
  .tl-scroll::-webkit-scrollbar { display: none; }
  .tl { position: relative; }
  .tl svg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .tl-axis { stroke: var(--global-text-color); stroke-opacity: .25; }
  .tl-mark { color: var(--global-text-color); --cc: var(--c); }
  .tl-mark.active { color: var(--cc); }
  .tl-text { position: absolute; left: 0; top: 0; font-size: 15px; line-height: 1.3; transform-origin: left center;
             color: var(--global-text-color) !important; text-decoration: none !important; cursor: default; will-change: transform, opacity; --cc: var(--c); }
  a.tl-text { cursor: pointer; }
  .tl-text.active { color: var(--cc) !important; font-family: Calibri, Carlito, sans-serif; font-weight: 700; }
  html[data-theme="dark"] .tl-text, html[data-theme="dark"] .tl-mark { --cc: color-mix(in srgb, var(--c) 50%, #fff); }
  .tl-date { font-size: 12px; opacity: .7; margin-right: 6px; }
  .tl-year { position: absolute; left: 0; top: 0; width: 38px; text-align: right; font-size: 12px; opacity: .5; transform-origin: right center; }
</style>

<div class="tl-wrap">
  <div class="tl-scroll" id="tlScroll"><div class="tl" id="tl"></div></div>
</div>

<script>
  const TL_UPDATES = {{ site.data.timeline | jsonify }};
</script>
{% raw %}
<script>
(() => {
const updates = TL_UPDATES;
const COLORS = {
  edu: "#233036", mile: "#773622", work: "#2b4a2a", teach: "#515636", paper: "#5a201f", conf: "#7b2e24",
  talk: "#8f5b33", grant: "#46413e", award: "#774224", sup: "#3c4029", cert: "#61605c", other: "#55322c", today: "#773622"
};

const PX_PER_DAY = 1.3;   // vertical scale
const AXIS_X = 48;        // x of the axis
const TEXT_DX = 16;       // text offset from axis
const LABEL_PAD = 4;      // min space between labels
const MIN_OP = 0.08;      // opacity at the far edges
const MARK_A = 0.3;       // marker alpha (not hovered)
const FRONT = 0.4;        // where the "front" sits in the viewport (0 = top, 1 = bottom)

const NS = "http://www.w3.org/2000/svg";
const scroller = document.getElementById("tlScroll");
const tl = document.getElementById("tl");
const ymd = d => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
const mk = (tag, attrs) => { const e = document.createElementNS(NS, tag); for (const k in attrs) e.setAttribute(k, attrs[k]); return e; };
const fmt = d => d.toLocaleDateString("en-GB", { month: "short", year: "numeric" });

function build() {
  const keep = scroller.scrollTop;
  tl.innerHTML = "";
  const svg = mk("svg", {}); tl.appendChild(svg);
  const VH = scroller.clientHeight, W = tl.clientWidth;
  const PAD_TOP = VH * FRONT, PAD_BOT = VH * (1 - FRONT);

  const now = new Date();
  const D = s => (s === "now" ? now : new Date(s + "T12:00:00"));
  const items = [...updates, { date: ymd(now), cat: "today", text: "Today" }].map(u => {
    const s = D(u.start || u.date), e = u.end ? D(u.end) : null;
    return { ...u, color: u.color || COLORS[u.cat] || "#444", s, e, isSpan: !!e };
  });
  const oldest = new Date(Math.min(...items.map(i => i.s)));
  const y = d => PAD_TOP + (now - d) / 864e5 * PX_PER_DAY;
  const totalH = y(oldest) + PAD_BOT;
  tl.style.height = totalH + "px";

  // drum projection: the timeline is a circle in the vertical/depth plane, seen edge-on
  const R = VH * 0.8, P = VH * 1.6, MAX_T = 1.3;
  const proj = (yy, st) => {
    let t = (yy - (st + VH * FRONT)) / R;
    const vis = Math.abs(t) < MAX_T;
    t = Math.max(-MAX_T, Math.min(MAX_T, t));
    const p = P / (P + R * (1 - Math.cos(t)));
    return { y: st + VH * FRONT + R * Math.sin(t) * p, p, c: Math.cos(t), vis };
  };
  const oOf = q => q.vis ? Math.max(0, MIN_OP + (1 - MIN_OP) * (q.c - Math.cos(MAX_T)) / (1 - Math.cos(MAX_T))) : 0;

  const axis = mk("path", { class: "tl-axis", fill: "none", "stroke-width": 1.5, "stroke-dasharray": "5 5" });
  svg.appendChild(axis);

  const years = [];
  for (let yr = now.getFullYear(); yr >= oldest.getFullYear(); yr--) {
    const yy = y(new Date(yr, 0, 1));
    const el = document.createElement("div");
    el.className = "tl-year"; el.textContent = yr;
    tl.appendChild(el); years.push({ el, yy });
  }

  // longer spans first, shorter spans on top, points on top of everything
  const rank = i => i.isSpan ? -(i.e - i.s) : Infinity;
  items.sort((a, b) => rank(a) - rank(b));
  items.forEach(i => {
    if (i.isSpan) i.mark = mk("path", { class: "tl-mark", fill: "none", stroke: "currentColor" });
    else {
      i.mark = mk("g", { class: "tl-mark" });
      i.mark.appendChild(mk("circle", { r: 7, fill: "none", stroke: "currentColor", "stroke-width": 1 }));
      i.mark.appendChild(mk("circle", { r: 3, fill: "currentColor" }));
    }
    i.mark.style.setProperty("--c", i.color);
    svg.appendChild(i.mark);

    const t = document.createElement(i.url ? "a" : "div");
    t.className = "tl-text"; t.style.setProperty("--c", i.color);
    t.style.width = (W - AXIS_X - TEXT_DX - 4) + "px";
    if (i.url) { t.href = i.url; t.target = "_blank"; t.rel = "noopener"; }
    const dl = i.cat === "today" ? now.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })
             : i.isSpan ? `${fmt(i.s)} – ${i.end === "now" ? "now" : fmt(i.e)}` : fmt(i.s);
    t.innerHTML = `<span class="tl-date">${dl}</span>`;
    t.appendChild(document.createTextNode(i.text));
    tl.appendChild(t); i.textEl = t; i.h = t.offsetHeight;

    const set = v => { i.active = v; t.classList.toggle("active", v); i.mark.classList.toggle("active", v); render(); };
    t.addEventListener("mouseenter", () => set(true)); t.addEventListener("mouseleave", () => set(false));
  });

  // labels anchored at their start date; nudge to avoid overlap
  items.forEach(i => i.ty = y(i.s));
  const byY = [...items].sort((a, b) => b.ty - a.ty);
  const gap = (a, b) => (a.h + b.h) / 2 + LABEL_PAD;
  for (let k = 1; k < byY.length; k++)
    if (byY[k - 1].ty - byY[k].ty < gap(byY[k - 1], byY[k])) byY[k].ty = byY[k - 1].ty - gap(byY[k - 1], byY[k]);
  for (let k = byY.length - 1; k >= 0; k--) {
    const lim = k === byY.length - 1 ? PAD_TOP - 60 : byY[k + 1].ty + gap(byY[k + 1], byY[k]);
    if (byY[k].ty < lim) byY[k].ty = lim;
  }

  const axisPath = (y0, y1, st, step = 4) => {
    let d = "";
    for (let yy = y0; yy <= y1 + 0.01; yy += step) d += (d ? "L" : "M") + AXIS_X + " " + proj(Math.min(yy, y1), st).y.toFixed(1);
    if (y1 - y0 < step) d += "L" + AXIS_X + " " + proj(y1, st).y.toFixed(1);
    return d;
  };

  function render() {
    const st = scroller.scrollTop;
    const v0 = Math.max(0, st + VH * FRONT - R * MAX_T), v1 = Math.min(totalH, st + VH * FRONT + R * MAX_T);
    axis.setAttribute("d", axisPath(v0, v1, st));

    years.forEach(({ el, yy }) => {
      const q = proj(yy, st);
      el.style.transform = `translate(0, ${q.y}px) translateY(-50%) scale(${q.p}, ${q.p * q.c})`;
      el.style.opacity = 0.5 * oOf(q);
    });

    items.forEach(i => {
      const a = i.active;
      if (i.isSpan) {
        const y0 = Math.max(y(i.e), v0), y1 = Math.min(Math.max(y(i.s), y(i.e) + 2), v1);
        if (y1 <= y0) i.mark.setAttribute("d", "");
        else {
          i.mark.setAttribute("d", axisPath(y0, y1, st, 2));
          const qm = proj(Math.min(Math.max(st + VH * FRONT, y0), y1), st);
          i.mark.setAttribute("stroke-width", (a ? 7 : 4) * qm.p);
          i.mark.style.opacity = a ? 1 : MARK_A * oOf(qm);
        }
      } else {
        const q = proj(y(i.s), st);
        i.mark.setAttribute("transform", `translate(${AXIS_X},${q.y}) scale(${(a ? 1.35 : 1) * q.p})`);
        i.mark.style.opacity = a ? 1 : MARK_A * oOf(q);
      }
      const q = proj(i.ty, st);
      i.textEl.style.transform = `translate(${AXIS_X + TEXT_DX * q.p}px, ${q.y}px) translateY(-50%) scale(${q.p}, ${q.p * q.c})`;
      i.textEl.style.opacity = a ? 1 : oOf(q);
      i.textEl.style.pointerEvents = q.vis ? "" : "none";
    });
  }

  let raf = 0;
  scroller.onscroll = () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(render); };
  scroller.scrollTop = keep;
  render();
}

let day = ymd(new Date()), w = 0, rt = 0;
const start = () => { w = tl.clientWidth; build(); };
if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", start); else start();
// "Today" moves by itself; layout follows the column width
setInterval(() => { const d = ymd(new Date()); if (d !== day) { day = d; build(); } }, 60000);
window.addEventListener("resize", () => { clearTimeout(rt); rt = setTimeout(() => { if (tl.clientWidth !== w) { w = tl.clientWidth; build(); } }, 200); });
})();
</script>
{% endraw %}
